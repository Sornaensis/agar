{
  "name": "agar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "build:pages": "npm run check && vite build --outDir docs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:all": "npm run build:wasm && npm run build",
    "test:engine": "cargo test --manifest-path engine/Cargo.toml",
    "test:wasm": "node scripts/check-wasm.mjs",
    "test:graph": "node scripts/check-genome-network.mjs",
    "test:language": "node scripts/check-genome-language.mjs",
    "test:cellular-ui": "node scripts/check-cellular-ui.mjs",
    "test:inspection": "node scripts/check-program-inspection.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:storage": "node scripts/check-storage.mjs",
    "test:session": "node scripts/check-session.mjs",
    "check:engine": "node scripts/check-engine-artifact.mjs",
    "test:food-chain": "node scripts/check-cellular-navigation.mjs",
    "test:food-chain:legacy": "node scripts/check-food-chain.mjs",
    "test:navigation": "node scripts/check-cellular-navigation.mjs",
    "test:navigation:legacy": "node scripts/check-preset-navigation.mjs",
    "test:ecosystem": "node --no-liftoff scripts/check-ecosystem.mjs --assert --duration 600 --seed 42",
    "bench:simulation": "node --no-liftoff scripts/benchmark-simulation.mjs",
    "test:worker": "node scripts/check-worker.mjs",
    "test:cellular": "node scripts/check-cellular.mjs",
    "test:camera": "node scripts/check-camera.mjs",
    "test:environment-controls": "node scripts/check-environment-controls.mjs",
    "test:player-view": "node scripts/check-player-view.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "7.2.2"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.8",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5"
  }
}
