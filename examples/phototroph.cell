# Shared products supply independently regulated physical recipes.
# Genes make stock; start_when permits new machines; activity runs built ones.
cellular counts;

product Catalyst = enzyme();
product Wall = membrane();
product Mount = anchor();
product Pigment = pigment();
product CoatPrecursor = scaffold();
product Glue = adhesin(CoatPrecursor);
product Carrier = transporter();
product Frame = scaffold();
product Replicase = replicase();
product Rotor = motor();
product Ring = constrictor();

# Tolerate modest wear while repair restores working capacity. The allowance
# stays below one machine, even when a larger body needs many copies.
fn missing(installed, required, unit) = installed + 0.000001 < required - min(required * 0.1, unit * 0.2);
fn enough(installed, required) = installed + 0.000001 >= required * 0.9;

let funded = (energy > 100000 || gut.energy > 0) && nutrient.stored > 10;
let expanding = body.area > body.birth_area * 1.6;
let powered = enough(built.Solar, 0.12) && enough(built.Respiration, 0.04);
let equipped = powered;
# Duplicate the four machines a daughter needs to feed and make proteins.
let preparing_daughters = body.area > body.birth_area * 1.45;
let provisioned = enough(built.Respiration, 0.08) && enough(built.Solar, 0.24) && enough(built.Minerals, 0.05) && enough(built.Translation, 0.08);
let surplus = equipped && energy > 550000;
# A receptive grazer can share surplus fixed carbon and dissolved minerals.
publish rf090 = 41;
rf091 = 72;
# This stationary producer spends no material on locomotion.

let need_Respiration = funded && (true) && missing(built.Respiration, (if preparing_daughters then 0.08 else 0.04), 0.04);
let need_Solar = funded && (true) && missing(built.Solar, (if preparing_daughters then 0.24 else 0.12), 0.12);
let need_Dock = funded && (powered) && missing(built.Dock, (if expanding then 0.04 else 0.02), 0.02);
let need_CarbonPort = funded && (powered) && missing(built.CarbonPort, (if expanding then 0.1 else 0.05), 0.05);
let need_MineralPort = funded && (powered) && missing(built.MineralPort, (if expanding then 0.04 else 0.02), 0.02);
let need_Translation = funded && (powered) && missing(built.Translation, (if preparing_daughters then 0.08 else 0.04), 0.04);
let need_Minerals = funded && (powered || nutrient.stored < 1300) && missing(built.Minerals, (if preparing_daughters then 0.05 else 0.025), 0.025);
let need_EnergyStore = funded && (powered) && missing(built.EnergyStore, (if expanding || energy.capacity <= 1000000 then 0.08 else 0.04), 0.04);
let need_MineralStore = funded && (powered && body.area > 1.2) && missing(built.MineralStore, (if expanding then 0.04 else 0.02), 0.02);
let need_Repair = funded && (integrity < 0.995) && missing(built.Repair, (if expanding then 0.05 else 0.025), 0.025);
let need_Support = funded && (powered && energy > 450000) && missing(built.Support, max(0.12, body.birth_area * 0.12), 0.06);
let need_Envelope = funded && (enough(built.Support, 0.12)) && missing(built.Envelope, (if expanding then 0.04 else 0.02), 0.02);
let need_Replication = funded && (enough(built.Support, 0.12)) && missing(built.Replication, (if expanding then 0.04 else 0.02), 0.02);
let need_Division = funded && (expanding) && missing(built.Division, (if expanding then 0.04 else 0.02), 0.02);

gene supply_CoatPrecursor: CoatPrecursor = if need_Dock && pool.Glue < 10 && pool.CoatPrecursor < 10 then 1 else 0;
gene supply_Catalyst: Catalyst = if pool.Catalyst < 10 then (if need_Respiration then 1 else 0) + (if need_Solar then 0.25 else 0) + (if need_Translation then 1 else 0) + (if need_Repair then 1 else 0) + (if need_Envelope then 0.333333 else 0) else 0;
gene supply_Wall: Wall = if pool.Wall < 10 then (if need_Respiration then 0.6 else 0) + (if need_Dock then 1 else 0) + (if need_CarbonPort then 1 else 0) + (if need_MineralPort then 1 else 0) + (if need_EnergyStore then 1 else 0) + (if need_MineralStore then 1 else 0) + (if need_Envelope then 1 else 0) else 0;
gene supply_Mount: Mount = if pool.Mount < 10 then (if need_Solar then 0.25 else 0) + (if need_Dock then 1 else 0) + (if need_Minerals then 0.25 else 0) + (if need_Division then 0.5 else 0) else 0;
gene supply_Pigment: Pigment = if pool.Pigment < 10 then (if need_Solar then 1 else 0) else 0;
gene supply_Glue: Glue = if pool.Glue < 10 then (if need_Dock then 0.5 else 0) else 0;
gene supply_Carrier: Carrier = if pool.Carrier < 10 then (if need_CarbonPort then 1 else 0) + (if need_MineralPort then 1 else 0) + (if need_Minerals then 1 else 0) else 0;
gene supply_Frame: Frame = if pool.Frame < 10 then (if need_Translation then 1 else 0) + (if need_Support then 1 else 0) + (if need_Replication then 0.333333 else 0) else 0;
gene supply_Replicase: Replicase = if pool.Replicase < 10 then (if need_Replication then 1 else 0) else 0;
gene supply_Rotor: Rotor = if pool.Rotor < 10 then (if need_Division then 1 else 0) else 0;
gene supply_Ring: Ring = if pool.Ring < 10 then (if need_Division then 1 else 0) else 0;

assembly Respiration: respire(oxygen) {
  Catalyst: 250;
  Wall: 150;
  start_when: need_Respiration;
  activity: if oxygen > 0 && energy.fraction < 0.98 && (carbon.organic > 24000 * body.area || energy < 450000) then 1 else 0;
}

assembly Solar: harvest(light) {
  Mount: 200;
  Pigment: 800;
  Catalyst: 200;
  start_when: need_Solar;
  activity: 1;
}

assembly Dock: adhere() {
  Mount: 80;
  Wall: 80;
  Glue: 40;
  start_when: need_Dock;
  activity: 1;
  engage_when: populated(rf091) && peer.message_valid && peer.message == rf091;
}

assembly CarbonPort: junction(carbon) {
  Wall: 250;
  Carrier: 250;
  start_when: need_CarbonPort;
  activity: if carbon.organic > 4500 * body.area && energy > 240000 then 1 else 0;
}

assembly MineralPort: junction(mineral) {
  Wall: 100;
  Carrier: 100;
  start_when: need_MineralPort;
  activity: if nutrient.fraction < 0.8 then 1 else 0;
}

assembly Translation: translate() {
  Frame: 200;
  Catalyst: 200;
  start_when: need_Translation;
  activity: 1;
}

assembly Minerals: import(mineral) {
  Mount: 50;
  Carrier: 200;
  start_when: need_Minerals;
  activity: if nutrient.fraction < 0.9 then 1 else 0;
}

assembly EnergyStore: store(energy) {
  Wall: 400;
  start_when: need_EnergyStore;
  activity: 1;
}

assembly MineralStore: store(mineral) {
  Wall: 200;
  start_when: need_MineralStore;
  activity: 1;
}

assembly Repair: repair() {
  Catalyst: 250;
  start_when: need_Repair;
  activity: 1;
}

assembly Support: support() {
  Frame: 600;
  start_when: need_Support;
  activity: 1;
}

assembly Envelope: grow() {
  Wall: 150;
  Catalyst: 50;
  start_when: need_Envelope;
  activity: if energy > 900000 && body.area < body.birth_area * 2 then 0.8 else 0;
}

assembly Replication: replicate() {
  Frame: 50;
  Replicase: 150;
  start_when: need_Replication;
  activity: if energy > 800000 then 1 else 0;
}

assembly Division: constrict() {
  Mount: 40;
  Rotor: 80;
  Ring: 80;
  start_when: need_Division;
  activity: if body.area + 0.000001 >= body.birth_area * 2 && provisioned && energy > 1000000 then 1 else 0;
}
