# Shared products supply independently regulated physical recipes.
# Genes make stock; start_when permits new machines; activity runs built ones.
cellular;

product Wall = membrane();
product Catalyst = enzyme();
product Mount = anchor();
product Rotor = motor();
product Frame = scaffold();
product Carrier = transporter();
product Tail = filament();
product Detector = receptor();
product Pigment = pigment();
product Replicase = replicase();
product Ring = constrictor();
product Persistence = regulator(8);

fn missing(installed, required) = installed + 0.000001 < required;
fn buffered(stock, effort) = if stock < 0.001 then effort else 0;

let funded = energy > 10 && nutrient.stored > 0.001;
let expanding = body.area > body.birth_area * 1.6;
let powered = built.Gut + 0.000001 >= 0.06 && built.ExudateEnzyme + 0.000001 >= 0.04 && built.Capture + 0.000001 >= 0.03;
let difference = sensed.LeftChemistry.organic - sensed.RightChemistry.organic;
let steer = if sensed.LeftChemistry.valid && sensed.RightChemistry.valid && abs(difference) > 0.000001
  then clamp(difference * 100, -1, 1) else sin(age * 0.5) * 0.3;
let move = if gut.fraction > 0.5 then 0 else 0.15 + 0.25 * activate(concentration.Persistence, 0.002);

let need_Gut = funded && (true) && missing(built.Gut, (if expanding then 0.12 else 0.06));
let need_ExudateEnzyme = funded && (true) && missing(built.ExudateEnzyme, (if expanding then 0.08 else 0.04));
let need_Capture = funded && (built.Gut + 0.000001 >= 0.06) && missing(built.Capture, (if expanding then 0.06 else 0.03));
let need_TissueEnzyme = funded && (powered) && missing(built.TissueEnzyme, (if expanding then 0.04 else 0.02));
let need_WasteEnzyme = funded && (powered) && missing(built.WasteEnzyme, (if expanding then 0.03 else 0.015));
let need_Translation = funded && (powered) && missing(built.Translation, (if expanding then 0.08 else 0.04));
let need_Minerals = funded && (powered) && missing(built.Minerals, (if expanding then 0.05 else 0.025));
let need_EnergyStore = funded && (powered) && missing(built.EnergyStore, (if expanding then 0.16 else 0.08));
let need_MineralStore = funded && (powered) && missing(built.MineralStore, (if expanding then 0.04 else 0.02));
let need_LeftMotor = funded && (powered) && missing(built.LeftMotor, (if expanding then 0.05 else 0.025));
let need_RightMotor = funded && (powered) && missing(built.RightMotor, (if expanding then 0.05 else 0.025));
let need_Vision = funded && (powered) && missing(built.Vision, (if expanding then 0.04 else 0.02));
let need_Touch = funded && (powered) && missing(built.Touch, (if expanding then 0.02 else 0.01));
let need_LeftChemistry = funded && (powered) && missing(built.LeftChemistry, (if expanding then 0.03 else 0.015));
let need_RightChemistry = funded && (powered) && missing(built.RightChemistry, (if expanding then 0.03 else 0.015));
let need_Support = funded && (powered && energy > 45) && missing(built.Support, max(0.12, body.birth_area * 0.12));
let need_Envelope = funded && (built.Support + 0.000001 >= 0.12) && missing(built.Envelope, (if expanding then 0.04 else 0.02));
let need_Replication = funded && (built.Support + 0.000001 >= 0.12) && missing(built.Replication, (if expanding then 0.04 else 0.02));
let need_Division = funded && (expanding) && missing(built.Division, (if expanding then 0.04 else 0.02));

gene supply_Wall: Wall = buffered(pool.Wall, (if need_Gut then 1 else 0) + (if need_EnergyStore then 1 else 0) + (if need_MineralStore then 1 else 0) + (if need_Envelope then 1 else 0));
gene supply_Catalyst: Catalyst = buffered(pool.Catalyst, (if need_ExudateEnzyme then 1 else 0) + (if need_TissueEnzyme then 1 else 0) + (if need_WasteEnzyme then 1 else 0) + (if need_Translation then 1 else 0) + (if need_Envelope then 0.333333 else 0));
gene supply_Mount: Mount = buffered(pool.Mount, (if need_Capture then 0.5 else 0) + (if need_Minerals then 0.25 else 0) + (if need_LeftMotor then 0.5 else 0) + (if need_RightMotor then 0.5 else 0) + (if need_Vision then 0.333333 else 0) + (if need_Touch then 0.333333 else 0) + (if need_LeftChemistry then 0.25 else 0) + (if need_RightChemistry then 0.25 else 0) + (if need_Division then 0.5 else 0));
gene supply_Rotor: Rotor = buffered(pool.Rotor, (if need_Capture then 1 else 0) + (if need_LeftMotor then 1 else 0) + (if need_RightMotor then 1 else 0) + (if need_Division then 1 else 0));
gene supply_Frame: Frame = buffered(pool.Frame, (if need_Translation then 1 else 0) + (if need_Support then 1 else 0) + (if need_Replication then 0.333333 else 0));
gene supply_Carrier: Carrier = buffered(pool.Carrier, (if need_Minerals then 1 else 0));
gene supply_Tail: Tail = buffered(pool.Tail, (if need_LeftMotor then 1 else 0) + (if need_RightMotor then 1 else 0) + (if need_Touch then 0.333333 else 0));
gene supply_Detector: Detector = buffered(pool.Detector, (if need_Vision then 1 else 0) + (if need_Touch then 1 else 0) + (if need_LeftChemistry then 1 else 0) + (if need_RightChemistry then 1 else 0));
gene supply_Pigment: Pigment = buffered(pool.Pigment, (if need_Vision then 0.333333 else 0));
gene supply_Replicase: Replicase = buffered(pool.Replicase, (if need_Replication then 1 else 0));
gene supply_Ring: Ring = buffered(pool.Ring, (if need_Division then 1 else 0));

# Cue-driven material memory; growth dilutes its concentration.
gene remember: Persistence = if sensed.LeftChemistry.valid && sensed.RightChemistry.valid
  && concentration.Persistence < 0.008 then 0.15 * activate(sensed.LeftChemistry.organic + sensed.RightChemistry.organic, 0.002) else 0;

assembly Gut: store(food) {
  Wall: 0.06;
  start_when: need_Gut;
  activity: 1;
}

assembly ExudateEnzyme: digest(exudate) {
  Catalyst: 0.04;
  start_when: need_ExudateEnzyme;
  activity: if gut.exudate.energy > 0 then 1 else 0;
}

assembly Capture: import(particle) {
  Mount: 0.01;
  Rotor: 0.02;
  start_when: need_Capture;
  activity: if gut.fraction < 0.7 then 1 else 0;
}

assembly TissueEnzyme: digest(tissue) {
  Catalyst: 0.02;
  start_when: need_TissueEnzyme;
  activity: if gut.tissue.energy > 0 then 1 else 0;
}

assembly WasteEnzyme: digest(waste) {
  Catalyst: 0.015;
  start_when: need_WasteEnzyme;
  activity: if gut.waste.energy > 0 then 1 else 0;
}

assembly Translation: translate() {
  Frame: 0.02;
  Catalyst: 0.02;
  start_when: need_Translation;
  activity: 1;
}

assembly Minerals: import(mineral) {
  Mount: 0.005;
  Carrier: 0.02;
  start_when: need_Minerals;
  activity: if nutrient.fraction < 0.9 then 1 else 0;
}

assembly EnergyStore: store(energy) {
  Wall: 0.08;
  start_when: need_EnergyStore;
  activity: 1;
}

assembly MineralStore: store(mineral) {
  Wall: 0.02;
  start_when: need_MineralStore;
  activity: 1;
}

assembly LeftMotor: propel() {
  Mount: 0.005;
  Rotor: 0.01;
  Tail: 0.01;
  start_when: need_LeftMotor;
  activity: clamp(move - steer * 0.5, 0, 1);
  at: 1.570796;
  direction: 0;
}

assembly RightMotor: propel() {
  Mount: 0.005;
  Rotor: 0.01;
  Tail: 0.01;
  start_when: need_RightMotor;
  activity: clamp(move + steer * 0.5, 0, 1);
  at: -1.570796;
  direction: 0;
}

assembly Vision: sense(optical) {
  Mount: 0.004;
  Detector: 0.012;
  Pigment: 0.004;
  start_when: need_Vision;
  activity: 1;
}

assembly Touch: sense(contact) {
  Mount: 0.002;
  Detector: 0.006;
  Tail: 0.002;
  start_when: need_Touch;
  activity: 1;
}

assembly LeftChemistry: sense(chemical) {
  Mount: 0.003;
  Detector: 0.012;
  start_when: need_LeftChemistry;
  activity: 1;
  at: 1.570796;
}

assembly RightChemistry: sense(chemical) {
  Mount: 0.003;
  Detector: 0.012;
  start_when: need_RightChemistry;
  activity: 1;
  at: -1.570796;
}

assembly Support: support() {
  Frame: 0.06;
  start_when: need_Support;
  activity: 1;
}

assembly Envelope: grow() {
  Wall: 0.015;
  Catalyst: 0.005;
  start_when: need_Envelope;
  activity: if energy > 90 && body.area < body.birth_area * 2 then 0.8 else 0;
}

assembly Replication: replicate() {
  Frame: 0.005;
  Replicase: 0.015;
  start_when: need_Replication;
  activity: if energy > 80 then 1 else 0;
}

assembly Division: constrict() {
  Mount: 0.004;
  Rotor: 0.008;
  Ring: 0.008;
  start_when: need_Division;
  activity: if body.area + 0.000001 >= body.birth_area * 2 && energy > 100 then 1 else 0;
}
