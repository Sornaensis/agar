# Shared products supply independently regulated physical recipes.
# Genes make stock; start_when permits new machines; activity runs built ones.
cellular counts;

product Catalyst = enzyme();
product Wall = membrane();
product Mount = anchor();
product CoatPrecursor = scaffold();
product Glue = adhesin(CoatPrecursor);
product Carrier = transporter();
product Rotor = motor();
product Frame = scaffold();
product Tail = filament();
product Detector = receptor();
product Pigment = pigment();
product Replicase = replicase();
product Ring = constrictor();
product IsomeraseCatalyst = enzyme(90);

# Tolerate modest wear while repair restores working capacity. The allowance
# stays below one machine, even when a larger body needs many copies.
fn missing(installed, required, unit) = installed + 0.000001 < required - min(required * 0.1, unit * 0.2);
fn enough(installed, required) = installed + 0.000001 >= required * 0.9;

let funded = (energy > 100000 || gut.energy > 0) && nutrient.stored > 10;
let expanding = body.area > body.birth_area * 1.6;
let powered = enough(built.Gut, 0.045) && enough(built.ExudateEnzyme, 0.04) && enough(built.Capture, 0.03) && enough(built.Respiration, 0.04);
let equipped = powered && enough(built.LeftMotor, 0.025) && enough(built.RightMotor, 0.025) && enough(built.Vision, 0.02) && enough(built.Touch, 0.01);
let scavenging = gut.structural.energy > 60000;
let provisioning = expanding && (energy > 600000 || gut.soluble.energy + gut.structural.energy > 100000);
# Commit after a substantial meal or a productive carbon connection.
# A daughter can start with a smaller inherited ATP compartment.
rb061 = true when equipped && energy > min(650000, 0.85 * energy.capacity)
  && (gut.soluble.energy + gut.structural.energy > 55000
    || (gut.soluble.energy + gut.structural.energy > 30000 && carbon.organic > 8000 * body.area)
    || (built.CarbonPort > 0.045 && carbon.organic > 12000 * body.area && energy.fraction > 0.85));
let surplus = equipped && rb061 && energy > min(320000, 0.65 * energy.capacity);
# After recognizing a producer, build reciprocal junctions for future encounters.
publish rf090;
rf090 = 72;
rf091 = 41;
let docked = sensed.Touch.message_valid && sensed.Touch.message == rf091;
rb093 = true when docked;
# Swing around hard obstacles and stay near edible particles.
let injured = integrity < 0.995;
let seen = sensed.Vision.valid;
let blocked = sensed.Touch.valid && sensed.Touch.resistance >= 0.12;
let obstacle = if sensed.Touch.valid then angle(sensed.Touch.offset) else 0;
let escape = if obstacle >= 0 then obstacle - 1.8 else obstacle + 1.8;
let meal = gut.soluble.energy + gut.structural.energy;
# Rest or steer by cargo that can feed this cell with its installed enzymes.
let usable_meal = (if built.ExudateEnzyme > 0 then gut.soluble.energy else 0)
  + (if built.TissueEnzyme > 0 then gut.structural.energy else 0);
# A persistent plume with little captured carbon funds one adhesion patch.
# Its own contact guard still needs the local complementary display.
let poor_plume = sensed.LeftChemistry.valid && sensed.RightChemistry.valid
  && max(sensed.LeftChemistry.organic, sensed.RightChemistry.organic) > 0.002 && usable_meal < 10000 && !rb061 && body.area < 1.1 * body.birth_area;
clear rf096 when !poor_plume;
rf096 = age when poor_plume && !populated(rf096);
rb097 = true when poor_plume && populated(rf096) && age - rf096 > 6 && energy > 330000;
let meal_fraction = if gut.capacity > 0 then usable_meal / gut.capacity else 0;
let seek = meal_fraction < 0.55;
# Leave a known feeding contact if stored carbon and ATP stay low despite docking.
let depleted = energy.fraction < 0.55 && carbon.organic < 2500 * body.area && usable_meal < 25000;
rf094 = age when !docked || !depleted;
let starved_at_contact = docked && depleted && populated(rf094) && age - rf094 >= 6;
rf095 = age when starved_at_contact && (!populated(rf095) || age - rf095 > 24);
let leaving = populated(rf095) && age - rf095 < 8;
let grazing = seen && sensed.Vision.area >= 0.35
  && length(sensed.Vision.offset) < 7 * sqrt(sensed.Vision.area) + 5;
let particle = seen && sensed.Vision.area < 0.35;
let gradient = sensed.LeftChemistry.organic - sensed.RightChemistry.organic;
let has_gradient = sensed.LeftChemistry.valid && sensed.RightChemistry.valid && abs(gradient) > 0.0001;
let steer = if blocked then clamp(escape * 2, -1, 1)
  else if injured || leaving then 0
  else if seek && particle then clamp(angle(sensed.Vision.offset) * 1.8, -1, 1)
  else if seek && has_gradient then clamp(gradient * 35, -1, 1)
  else if grazing then clamp((angle(sensed.Vision.offset) - 1.4) * 1.8, -1, 1)
  else if seek && seen then clamp(angle(sensed.Vision.offset) * 1.8, -1, 1)
  else sin(age * 0.65) * 0.35;
let move = if blocked || injured || leaving then 0.65 else if meal_fraction > 0.45 then 0
  else if seek && particle then 0.55 else if has_gradient then 0.35 else 0.23;

let need_Respiration = funded && (true) && missing(built.Respiration, (if expanding then 0.08 else 0.04), 0.04);
let need_Dock = funded && (equipped && (rb093 || rb097)) && missing(built.Dock, 0.02, 0.02);
let need_CarbonPort = funded && (equipped && rb093) && missing(built.CarbonPort, 0.05, 0.05);
let need_MineralPort = funded && (equipped && rb093) && missing(built.MineralPort, 0.02, 0.02);
let need_Badge = funded && (powered) && missing(built.Badge, 0.01, 0.01);
let need_Gut = funded && (true) && missing(built.Gut, (if provisioning then 0.135 else 0.045), 0.045);
let need_ExudateEnzyme = funded && (true) && missing(built.ExudateEnzyme, (if provisioning then 0.08 else 0.04), 0.04);
let need_Capture = funded && (enough(built.Gut, 0.045)) && missing(built.Capture, (if provisioning then 0.06 else 0.03), 0.03);
let need_TissueEnzyme = funded && (powered && gut.structural.energy > 0) && missing(built.TissueEnzyme, (if scavenging then 0.08 else if provisioning then 0.08 else 0.04), 0.04);
let need_WasteEnzyme = funded && (powered && gut.bound.energy > 0) && missing(built.WasteEnzyme, (if provisioning then 0.03 else 0.015), 0.015);
let need_Translation = funded && (powered) && missing(built.Translation, (if body.area > body.birth_area * 1.3 then 0.08 else 0.04), 0.02);
let need_Minerals = funded && (powered && (nutrient.stored < 1500 || surplus)) && missing(built.Minerals, (if expanding then 0.05 else 0.025), 0.025);
let need_EnergyStore = funded && (surplus) && missing(built.EnergyStore, (if expanding then 0.04 else 0.02), 0.02);
let need_MineralStore = funded && (surplus && body.area > 1.25) && missing(built.MineralStore, (if expanding then 0.04 else 0.02), 0.02);
let need_LeftMotor = funded && (powered) && missing(built.LeftMotor, (if provisioning then 0.05 else 0.025), 0.025);
let need_RightMotor = funded && (powered) && missing(built.RightMotor, (if provisioning then 0.05 else 0.025), 0.025);
let need_Vision = funded && (powered) && missing(built.Vision, (if provisioning then 0.04 else 0.02), 0.02);
let need_Touch = funded && (powered) && missing(built.Touch, (if provisioning then 0.02 else 0.01), 0.01);
let need_LeftChemistry = funded && (powered) && missing(built.LeftChemistry, (if provisioning then 0.03 else 0.015), 0.015);
let need_RightChemistry = funded && (powered) && missing(built.RightChemistry, (if provisioning then 0.03 else 0.015), 0.015);
let need_Repair = funded && (integrity < 0.995) && missing(built.Repair, (if provisioning then 0.05 else 0.025), 0.025);
let need_Support = funded && (surplus) && missing(built.Support, max(0.12, body.birth_area * 0.12), 0.06);
let need_Envelope = funded && (enough(built.Support, 0.12)) && missing(built.Envelope, (if provisioning then 0.04 else 0.02), 0.02);
let need_Replication = funded && (enough(built.Support, 0.12)) && missing(built.Replication, (if provisioning then 0.04 else 0.02), 0.02);
let need_Division = funded && (surplus && body.area > 1.5 * body.birth_area) && missing(built.Division, (if provisioning then 0.04 else 0.02), 0.02);
let need_FlankInlet = funded && (powered) && missing(built.FlankInlet, 0.015, 0.015);
let need_FarInlet = funded && (powered) && missing(built.FarInlet, 0.015, 0.015);
let need_RecoveryEnzyme = funded && (carbon.ligand > 0) && missing(built.RecoveryEnzyme, 0.02, 0.02);

gene supply_CoatPrecursor: CoatPrecursor = if (need_Dock) && pool.Glue < 10 && pool.CoatPrecursor < 10 then 1 else 0;
gene supply_Catalyst: Catalyst = if pool.Catalyst < 10 then (if need_Respiration then 1 else 0) + (if need_ExudateEnzyme then 1 else 0) + (if need_TissueEnzyme then 1 else 0) + (if need_WasteEnzyme then 1 else 0) + (if need_Translation then 1 else 0) + (if need_Repair then 1 else 0) + (if need_Envelope then 0.333333 else 0) else 0;
gene supply_Wall: Wall = if pool.Wall < 10 then (if need_Respiration then 0.6 else 0) + (if need_Dock then 1 else 0) + (if need_CarbonPort then 1 else 0) + (if need_MineralPort then 1 else 0) + (if need_Badge then 1 else 0) + (if need_Gut then 1 else 0) + (if need_EnergyStore then 1 else 0) + (if need_MineralStore then 1 else 0) + (if need_Envelope then 1 else 0) else 0;
gene supply_Mount: Mount = if pool.Mount < 10 then (if need_Dock then 1 else 0) + (if need_Badge then 0.666667 else 0) + (if need_Capture then 0.5 else 0) + (if need_Minerals then 0.25 else 0) + (if need_LeftMotor then 0.5 else 0) + (if need_RightMotor then 0.5 else 0) + (if need_Vision then 0.333333 else 0) + (if need_Touch then 0.333333 else 0) + (if need_LeftChemistry then 0.25 else 0) + (if need_RightChemistry then 0.25 else 0) + (if need_Division then 0.5 else 0) + (if need_FlankInlet then 0.5 else 0) + (if need_FarInlet then 0.5 else 0) else 0;
gene supply_Glue: Glue = if pool.Glue < 10 then (if need_Dock then 0.5 else 0) else 0;
gene supply_Carrier: Carrier = if pool.Carrier < 10 then (if need_CarbonPort then 1 else 0) + (if need_MineralPort then 1 else 0) + (if need_Minerals then 1 else 0) else 0;
gene supply_Rotor: Rotor = if pool.Rotor < 10 then (if need_Capture then 1 else 0) + (if need_LeftMotor then 1 else 0) + (if need_RightMotor then 1 else 0) + (if need_Division then 1 else 0) + (if need_FlankInlet then 1 else 0) + (if need_FarInlet then 1 else 0) else 0;
gene supply_Frame: Frame = if pool.Frame < 10 then (if need_Translation then 1 else 0) + (if need_Support then 1 else 0) + (if need_Replication then 0.333333 else 0) else 0;
gene supply_Tail: Tail = if pool.Tail < 10 then (if need_LeftMotor then 1 else 0) + (if need_RightMotor then 1 else 0) + (if need_Touch then 0.333333 else 0) else 0;
gene supply_Detector: Detector = if pool.Detector < 10 then (if need_Vision then 1 else 0) + (if need_Touch then 1 else 0) + (if need_LeftChemistry then 1 else 0) + (if need_RightChemistry then 1 else 0) else 0;
gene supply_Pigment: Pigment = if pool.Pigment < 10 then (if need_Vision then 0.333333 else 0) else 0;
gene supply_Replicase: Replicase = if pool.Replicase < 10 then (if need_Replication then 1 else 0) else 0;
gene supply_Ring: Ring = if pool.Ring < 10 then (if need_Division then 1 else 0) else 0;
gene supply_IsomeraseCatalyst: IsomeraseCatalyst = if pool.IsomeraseCatalyst < 10 then (if need_RecoveryEnzyme then 1 else 0) else 0;

assembly Respiration: respire(oxygen) {
  Catalyst: 250;
  Wall: 150;
  start_when: need_Respiration;
  activity: if oxygen > 0 && energy.fraction < 0.98 && (carbon.organic > (if energy > 620000 then 6500 else 1800) * body.area || energy < 200000) then 1 else 0;
}

assembly Dock: adhere() {
  Mount: 80;
  Wall: 80;
  Glue: 40;
  start_when: need_Dock;
  activity: if injured || leaving then 0 else 1;
  engage_when: populated(rf091) && peer.message_valid && peer.message == rf091;
}

assembly CarbonPort: junction(carbon) {
  Wall: 250;
  Carrier: 250;
  start_when: need_CarbonPort;
  activity: if carbon.organic < 18000 * body.area then 1 else 0;
}

assembly MineralPort: junction(mineral) {
  Wall: 100;
  Carrier: 100;
  start_when: need_MineralPort;
  activity: if nutrient.fraction > 0.72 && nutrient.stored > 3000 * body.area then 1 else 0;
}

assembly Badge: display() {
  Mount: 40;
  Wall: 60;
  start_when: need_Badge;
  activity: 1;
}

assembly Gut: store(food) {
  Wall: 450;
  start_when: need_Gut;
  activity: 1;
}

assembly ExudateEnzyme: digest(soluble) {
  Catalyst: 400;
  start_when: need_ExudateEnzyme;
  activity: if gut.soluble.energy > 0 then 1 else 0;
}

assembly Capture: import(particle) {
  Mount: 100;
  Rotor: 200;
  start_when: need_Capture;
  activity: if gut.fraction < 0.7 then 1 else 0;
}

assembly TissueEnzyme: digest(structural) {
  Catalyst: 400;
  start_when: need_TissueEnzyme;
  activity: if gut.structural.energy > 0 then 1 else 0;
}

assembly WasteEnzyme: digest(bound) {
  Catalyst: 150;
  start_when: need_WasteEnzyme;
  activity: if gut.bound.energy > 0 then 1 else 0;
}

assembly Translation: translate() {
  Frame: 100;
  Catalyst: 100;
  start_when: need_Translation;
  activity: 1;
}

assembly Minerals: import(mineral) {
  Mount: 50;
  Carrier: 200;
  start_when: need_Minerals;
  activity: if nutrient.fraction < 0.9 && energy.fraction > 0.05 then 1 else 0;
}

assembly EnergyStore: store(energy) {
  Wall: 200;
  start_when: need_EnergyStore;
  activity: 1;
}

assembly MineralStore: store(mineral) {
  Wall: 200;
  start_when: need_MineralStore;
  activity: 1;
}

assembly LeftMotor: propel() {
  Mount: 50;
  Rotor: 100;
  Tail: 100;
  start_when: need_LeftMotor;
  activity: if (docked || usable_meal > 20000) && !injured && !leaving then 0 else clamp(move - steer * 0.5, 0, 1);
  at: 1.570796;
  direction: 0;
}

assembly RightMotor: propel() {
  Mount: 50;
  Rotor: 100;
  Tail: 100;
  start_when: need_RightMotor;
  activity: if (docked || usable_meal > 20000) && !injured && !leaving then 0 else clamp(move + steer * 0.5, 0, 1);
  at: -1.570796;
  direction: 0;
}

assembly Vision: sense(optical) {
  Mount: 40;
  Detector: 120;
  Pigment: 40;
  start_when: need_Vision;
  activity: 1;
}

assembly Touch: sense(contact) {
  Mount: 20;
  Detector: 60;
  Tail: 20;
  start_when: need_Touch;
  activity: 1;
}

assembly LeftChemistry: sense(chemical) {
  Mount: 30;
  Detector: 120;
  start_when: need_LeftChemistry;
  activity: 1;
  at: 1.570796;
}

assembly RightChemistry: sense(chemical) {
  Mount: 30;
  Detector: 120;
  start_when: need_RightChemistry;
  activity: 1;
  at: -1.570796;
}

assembly Repair: repair() {
  Catalyst: 250;
  start_when: need_Repair;
  activity: 1;
}

assembly Support: support() {
  Frame: 600;
  start_when: need_Support;
  activity: 1;
}

assembly Envelope: grow() {
  Wall: 150;
  Catalyst: 50;
  start_when: need_Envelope;
  activity: if energy > 330000 && (energy > 540000 || meal > 40000 || carbon.organic > 5800 * body.area) && body.area < body.birth_area * 2 then 0.8 else 0;
}

assembly Replication: replicate() {
  Frame: 50;
  Replicase: 150;
  start_when: need_Replication;
  activity: if energy > 330000 && (energy > 510000 || meal > 30000 || carbon.organic > 5000 * body.area) then 1 else 0;
}

assembly Division: constrict() {
  Mount: 40;
  Rotor: 80;
  Ring: 80;
  start_when: need_Division;
  activity: if body.area + 0.000001 >= body.birth_area * 2 && enough(built.Minerals,0.05) && enough(built.EnergyStore,0.04) && enough(built.MineralStore,0.04) && enough(built.Respiration,0.08) && enough(built.Translation,0.08) && energy > 490000 && meal + carbon.organic * 20 > 70000 * body.area then 1 else 0;
  at: 0;
}

assembly FlankInlet: import(particle) {
  Mount: 50;
  Rotor: 100;
  start_when: need_FlankInlet;
  activity: if gut.fraction < 0.9 then 1 else 0;
  at: 1.5707963267948966;
}

assembly FarInlet: import(particle) {
  Mount: 50;
  Rotor: 100;
  start_when: need_FarInlet;
  activity: if gut.fraction < 0.9 then 1 else 0;
  at: -1.5707963267948966;
}

assembly RecoveryEnzyme: isomerize(carbon) {
  IsomeraseCatalyst: 200;
  start_when: need_RecoveryEnzyme;
  activity: if carbon.ligand > 0 then 1 else 0;
}
