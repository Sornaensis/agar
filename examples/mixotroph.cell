# Shared products supply independently regulated physical recipes.
# Genes make stock; start_when permits new machines; activity runs built ones.
cellular counts;

product Catalyst = enzyme();
product Wall = membrane();
product Mount = anchor();
product Pigment = pigment();
product Detector = receptor();
product Rotor = motor();
product Frame = scaffold();
product Carrier = transporter();
product Tail = filament();
product Replicase = replicase();
product Ring = constrictor();

# Tolerate modest wear while repair restores working capacity. The allowance
# stays below one machine, even when a larger body needs many copies.
fn missing(installed, required, unit) = installed + 0.000001 < required - min(required * 0.1, unit * 0.2);
fn enough(installed, required) = installed + 0.000001 >= required * 0.9;

let funded = (energy > 100000 || gut.energy > 0) && nutrient.stored > 10;
let expanding = body.area > body.birth_area * 1.6;
let powered = enough(built.Solar, 0.08) && enough(built.Gut, 0.06) && enough(built.ExudateEnzyme, 0.04) && enough(built.Capture, 0.03) && enough(built.Respiration, 0.04);
let equipped = powered;
let surplus = equipped && energy > 550000;
# Only a built Canopy receptor can trigger a change of feeding mode.
# Between the two thresholds, keep the mode from the previous measurement.
rb050 = true when sensed.Canopy.valid && sensed.Canopy.level < 0.35;
clear rb050 when sensed.Canopy.valid && sensed.Canopy.level > 0.55;
let shade_feed = sensed.Canopy.valid && (sensed.Canopy.level < 0.35
  || (rb050 && sensed.Canopy.level <= 0.55));
# In dimmer sunlit water, a local food plume opens the inlet while Solar keeps fixing carbon.
let margin_meal = sensed.Canopy.valid && sensed.Canopy.level < 0.84
  && sensed.Chemistry.valid && sensed.Chemistry.organic > 0.008;
let steer = if shade_feed then sin(age * 0.7) * 0.35 else 0;
let move = if shade_feed && gut.fraction < 0.5 then 0.4 else 0;

let need_Respiration = funded && (true) && missing(built.Respiration, (if expanding then 0.08 else 0.04), 0.04);
let need_Solar = funded && (true) && missing(built.Solar, (if expanding then 0.16 else 0.08), 0.08);
let need_Canopy = funded && (true) && missing(built.Canopy, 0.01, 0.01);
let need_Gut = funded && (true) && missing(built.Gut, 0.06, 0.06);
let need_ExudateEnzyme = funded && (true) && missing(built.ExudateEnzyme, 0.04, 0.04);
let need_Capture = funded && (enough(built.Gut, 0.06)) && missing(built.Capture, 0.03, 0.03);
let need_TissueEnzyme = funded && (powered && gut.structural.energy > 0) && missing(built.TissueEnzyme, (if expanding then 0.02 else 0.01), 0.01);
let need_WasteEnzyme = funded && (powered && gut.bound.energy > 0) && missing(built.WasteEnzyme, (if expanding then 0.02 else 0.01), 0.01);
let need_Translation = funded && (powered) && missing(built.Translation, (if expanding then 0.08 else 0.04), 0.04);
let need_Minerals = funded && (powered && (nutrient.stored < 1500 || surplus)) && missing(built.Minerals, (if expanding then 0.05 else 0.025), 0.025);
let need_EnergyStore = funded && (powered) && missing(built.EnergyStore, (if expanding || energy.capacity <= 1000000 then 0.08 else 0.04), 0.04);
let need_MineralStore = funded && (powered && body.area > 1.2) && missing(built.MineralStore, (if expanding then 0.04 else 0.02), 0.02);
let need_LeftMotor = funded && (powered) && missing(built.LeftMotor, 0.025, 0.025);
let need_RightMotor = funded && (powered) && missing(built.RightMotor, 0.025, 0.025);
let need_Chemistry = funded && (surplus) && missing(built.Chemistry, 0.015, 0.015);
let need_Repair = funded && (integrity < 0.995) && missing(built.Repair, (if expanding then 0.05 else 0.025), 0.025);
let need_Support = funded && (equipped && energy > 650000) && missing(built.Support, max(0.12, body.birth_area * 0.12), 0.06);
let need_Envelope = funded && (enough(built.Support, 0.12)) && missing(built.Envelope, (if expanding then 0.04 else 0.02), 0.02);
let need_Replication = funded && (enough(built.Support, 0.12)) && missing(built.Replication, 0.02, 0.02);
let need_Division = funded && (expanding) && missing(built.Division, 0.02, 0.02);

gene supply_Catalyst: Catalyst = if pool.Catalyst < 10 then (if need_Respiration then 1 else 0) + (if need_Solar then 0.166667 else 0) + (if need_ExudateEnzyme then 1 else 0) + (if need_TissueEnzyme then 1 else 0) + (if need_WasteEnzyme then 1 else 0) + (if need_Translation then 1 else 0) + (if need_Repair then 1 else 0) + (if need_Envelope then 0.333333 else 0) else 0;
gene supply_Wall: Wall = if pool.Wall < 10 then (if need_Respiration then 0.6 else 0) + (if need_Gut then 1 else 0) + (if need_EnergyStore then 1 else 0) + (if need_MineralStore then 1 else 0) + (if need_Envelope then 1 else 0) else 0;
gene supply_Mount: Mount = if pool.Mount < 10 then (if need_Solar then 0.166667 else 0) + (if need_Canopy then 0.333333 else 0) + (if need_Capture then 0.5 else 0) + (if need_Minerals then 0.25 else 0) + (if need_LeftMotor then 0.5 else 0) + (if need_RightMotor then 0.5 else 0) + (if need_Chemistry then 0.25 else 0) + (if need_Division then 0.5 else 0) else 0;
gene supply_Pigment: Pigment = if pool.Pigment < 10 then (if need_Solar then 1 else 0) + (if need_Canopy then 0.333333 else 0) else 0;
gene supply_Detector: Detector = if pool.Detector < 10 then (if need_Canopy then 1 else 0) + (if need_Chemistry then 1 else 0) else 0;
gene supply_Rotor: Rotor = if pool.Rotor < 10 then (if need_Capture then 1 else 0) + (if need_LeftMotor then 1 else 0) + (if need_RightMotor then 1 else 0) + (if need_Division then 1 else 0) else 0;
gene supply_Frame: Frame = if pool.Frame < 10 then (if need_Translation then 1 else 0) + (if need_Support then 1 else 0) + (if need_Replication then 0.333333 else 0) else 0;
gene supply_Carrier: Carrier = if pool.Carrier < 10 then (if need_Minerals then 1 else 0) else 0;
gene supply_Tail: Tail = if pool.Tail < 10 then (if need_LeftMotor then 1 else 0) + (if need_RightMotor then 1 else 0) else 0;
gene supply_Replicase: Replicase = if pool.Replicase < 10 then (if need_Replication then 1 else 0) else 0;
gene supply_Ring: Ring = if pool.Ring < 10 then (if need_Division then 1 else 0) else 0;

assembly Respiration: respire(oxygen) {
  Catalyst: 250;
  Wall: 150;
  start_when: need_Respiration;
  activity: if oxygen > 0 && energy.fraction < 0.98 && (carbon.organic > 2000 * body.area || energy < 200000) then 1 else 0;
}

assembly Solar: harvest(light) {
  Mount: 100;
  Pigment: 600;
  Catalyst: 100;
  start_when: need_Solar;
  activity: if shade_feed then 0 else 1;
}

assembly Canopy: sense(light) {
  Mount: 20;
  Detector: 60;
  Pigment: 20;
  start_when: need_Canopy;
  activity: 1;
}

assembly Gut: store(food) {
  Wall: 600;
  start_when: need_Gut;
  activity: 1;
}

assembly ExudateEnzyme: digest(soluble) {
  Catalyst: 400;
  start_when: need_ExudateEnzyme;
  activity: if gut.soluble.energy > 0 then 1 else 0;
}

assembly Capture: import(particle) {
  Mount: 100;
  Rotor: 200;
  start_when: need_Capture;
  activity: if gut.fraction < 0.7 then (if shade_feed then 1 else if margin_meal then 0.6 else 0) else 0;
}

assembly TissueEnzyme: digest(structural) {
  Catalyst: 100;
  start_when: need_TissueEnzyme;
  activity: if gut.structural.energy > 0 then 1 else 0;
}

assembly WasteEnzyme: digest(bound) {
  Catalyst: 100;
  start_when: need_WasteEnzyme;
  activity: if gut.bound.energy > 0 then 1 else 0;
}

assembly Translation: translate() {
  Frame: 200;
  Catalyst: 200;
  start_when: need_Translation;
  activity: 1;
}

assembly Minerals: import(mineral) {
  Mount: 50;
  Carrier: 200;
  start_when: need_Minerals;
  activity: if nutrient.fraction < 0.9 && energy.fraction > 0.05 then 1 else 0;
}

assembly EnergyStore: store(energy) {
  Wall: 400;
  start_when: need_EnergyStore;
  activity: 1;
}

assembly MineralStore: store(mineral) {
  Wall: 200;
  start_when: need_MineralStore;
  activity: 1;
}

assembly LeftMotor: propel() {
  Mount: 50;
  Rotor: 100;
  Tail: 100;
  start_when: need_LeftMotor;
  activity: if gut.energy > 20000 then 0 else clamp(move - steer * 0.5, 0, 1);
  at: 1.570796;
  direction: 0;
}

assembly RightMotor: propel() {
  Mount: 50;
  Rotor: 100;
  Tail: 100;
  start_when: need_RightMotor;
  activity: if gut.energy > 20000 then 0 else clamp(move + steer * 0.5, 0, 1);
  at: -1.570796;
  direction: 0;
}

assembly Chemistry: sense(chemical) {
  Mount: 30;
  Detector: 120;
  start_when: need_Chemistry;
  activity: 1;
}

assembly Repair: repair() {
  Catalyst: 250;
  start_when: need_Repair;
  activity: 1;
}

assembly Support: support() {
  Frame: 600;
  start_when: need_Support;
  activity: 1;
}

assembly Envelope: grow() {
  Wall: 150;
  Catalyst: 50;
  start_when: need_Envelope;
  activity: if energy > 900000 && body.area < body.birth_area * 2 then 0.8 else 0;
}

assembly Replication: replicate() {
  Frame: 50;
  Replicase: 150;
  start_when: need_Replication;
  activity: if energy > 800000 then 1 else 0;
}

assembly Division: constrict() {
  Mount: 40;
  Rotor: 80;
  Ring: 80;
  start_when: need_Division;
  activity: if body.area + 0.000001 >= body.birth_area * 2 && energy > 1000000 then 1 else 0;
  at: 1.5707963267948966;
}
