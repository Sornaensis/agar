# A small, complete cellular program: make one light-harvesting machine.
cellular counts;

product Mount = anchor();
product Pigment = pigment();
product Catalyst = enzyme();

gene mounts: Mount = if built.Solar + 0.000001 < 0.04 && pool.Mount < 20 then 1 else 0;
gene pigments: Pigment = if built.Solar + 0.000001 < 0.04 && pool.Pigment < 20 then 1 else 0;
gene catalysts: Catalyst = if built.Solar + 0.000001 < 0.04 && pool.Catalyst < 20 then 1 else 0;

assembly Solar: harvest(light) {
  Mount: 100;
  Pigment: 200;
  Catalyst: 100;
  activity: 1;
}
