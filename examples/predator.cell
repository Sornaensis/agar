# Shared products supply independently regulated physical recipes.
# Genes make stock; start_when permits new machines; activity runs built ones.
cellular;

product Wall = membrane();
product Catalyst = enzyme();
product Mount = anchor();
product Rotor = motor();
product Frame = scaffold();
product Carrier = transporter();
product Tail = filament();
product Detector = receptor();
product Pigment = pigment();
product Replicase = replicase();
product Ring = constrictor();

# Tolerate modest wear while repair restores working capacity. The allowance
# stays below one machine, even when a larger body needs many copies.
fn missing(installed, required, unit) = installed + 0.000001 < required - min(required * 0.1, unit * 0.2);
fn enough(installed, required) = installed + 0.000001 >= required * 0.9;
fn buffered(stock, effort) = if stock < 0.001 then effort else 0;

let funded = (energy > 10 || gut.energy > 0) && nutrient.stored > 0.001;
let expanding = body.area > body.birth_area * 1.6;
let powered = enough(built.Gut, 0.06) && enough(built.ExudateEnzyme, 0.025) && enough(built.Capture, 0.03);
let equipped = powered && enough(built.LeftMotor, 0.025) && enough(built.RightMotor, 0.025) && enough(built.Vision, 0.02) && enough(built.Touch, 0.01) && enough(built.Piercer, 0.05) && enough(built.TissueEnzyme, 0.08);
let surplus = equipped && energy > 55;
let firm_contact = sensed.Touch.valid && sensed.Touch.resistance > 0.1;
let hungry = energy.fraction < 0.7 && gut.fraction < 0.45;
# Paired local temperatures select the cooler side before tissue is damaged.
let heat_escape = sensed.LeftHeat.valid && sensed.RightHeat.valid
  && max(sensed.LeftHeat.value, sensed.RightHeat.value) > 0.78;
let heat_delta = sensed.RightHeat.value - sensed.LeftHeat.value;
let cool_turn = if heat_delta < -0.002 then -0.75 else 0.75;
let steer = if heat_escape then cool_turn else if gut.fraction > 0.45 then 0 else if hungry && sensed.Vision.valid then clamp(angle(sensed.Vision.offset) * 1.8, -1, 1) else sin(age * 0.5) * (if equipped then 0.12 else 0.4);
let move = if heat_escape then 0.4 else if firm_contact || gut.fraction > 0.45 then 0 else if hungry && sensed.Vision.valid then 0.5 else if hungry && equipped then 0.28 else 0.07;

let need_Gut = funded && (true) && missing(built.Gut, (if expanding then 0.12 else 0.06), 0.06);
let need_ExudateEnzyme = funded && (true) && missing(built.ExudateEnzyme, (if expanding then 0.05 else 0.025), 0.025);
let need_Capture = funded && (enough(built.Gut, 0.06)) && missing(built.Capture, (if expanding then 0.06 else 0.03), 0.03);
let need_TissueEnzyme = funded && (powered) && missing(built.TissueEnzyme, (if expanding then 0.16 else 0.08), 0.08);
let need_WasteEnzyme = funded && (powered && gut.waste.energy > 0) && missing(built.WasteEnzyme, (if expanding then 0.03 else 0.015), 0.015);
let need_Translation = funded && (surplus && body.area > 1.2) && missing(built.Translation, (if expanding then 0.08 else 0.04), 0.04);
let need_Minerals = funded && (powered && (nutrient.stored < 0.15 || surplus)) && missing(built.Minerals, (if expanding then 0.05 else 0.025), 0.025);
let need_EnergyStore = funded && (surplus) && missing(built.EnergyStore, (if expanding then 0.16 else 0.08), 0.08);
let need_MineralStore = funded && (surplus) && missing(built.MineralStore, (if expanding then 0.04 else 0.02), 0.02);
let need_LeftMotor = funded && (powered) && missing(built.LeftMotor, (if expanding then 0.05 else 0.025), 0.025);
let need_RightMotor = funded && (powered) && missing(built.RightMotor, (if expanding then 0.05 else 0.025), 0.025);
let need_Vision = funded && (powered) && missing(built.Vision, (if expanding then 0.04 else 0.02), 0.02);
let need_Touch = funded && (powered) && missing(built.Touch, (if expanding then 0.02 else 0.01), 0.01);
let need_Piercer = funded && (powered) && missing(built.Piercer, (if expanding then 0.1 else 0.05), 0.05);
let need_Engulfment = funded && (surplus && body.area > 1.2) && missing(built.Engulfment, (if expanding then 0.05 else 0.025), 0.025);
let need_Repair = funded && (integrity < 0.995) && missing(built.Repair, (if expanding then 0.05 else 0.025), 0.025);
let need_Support = funded && (equipped && energy > 65) && missing(built.Support, max(0.12, body.birth_area * 0.12), 0.06);
let need_Envelope = funded && (enough(built.Support, 0.12)) && missing(built.Envelope, (if expanding then 0.04 else 0.02), 0.02);
let need_Replication = funded && (enough(built.Support, 0.12)) && missing(built.Replication, (if expanding then 0.04 else 0.02), 0.02);
let need_Division = funded && (expanding) && missing(built.Division, (if expanding then 0.04 else 0.02), 0.02);
let need_LeftHeat = funded && (powered) && missing(built.LeftHeat, (if expanding then 0.02 else 0.01), 0.01);
let need_RightHeat = funded && (powered) && missing(built.RightHeat, (if expanding then 0.02 else 0.01), 0.01);

gene supply_Wall: Wall = buffered(pool.Wall, (if need_Gut then 1 else 0) + (if need_EnergyStore then 1 else 0) + (if need_MineralStore then 1 else 0) + (if need_Engulfment then 1 else 0) + (if need_Envelope then 1 else 0));
gene supply_Catalyst: Catalyst = buffered(pool.Catalyst, (if need_ExudateEnzyme then 1 else 0) + (if need_TissueEnzyme then 1 else 0) + (if need_WasteEnzyme then 1 else 0) + (if need_Translation then 1 else 0) + (if need_Piercer then 0.333333 else 0) + (if need_Repair then 1 else 0) + (if need_Envelope then 0.333333 else 0));
gene supply_Mount: Mount = buffered(pool.Mount, (if need_Capture then 0.5 else 0) + (if need_Minerals then 0.25 else 0) + (if need_LeftMotor then 0.5 else 0) + (if need_RightMotor then 0.5 else 0) + (if need_Vision then 0.333333 else 0) + (if need_Touch then 0.333333 else 0) + (if need_Piercer then 0.333333 else 0) + (if need_Engulfment then 0.5 else 0) + (if need_Division then 0.5 else 0) + (if need_LeftHeat then 0.25 else 0) + (if need_RightHeat then 0.25 else 0));
gene supply_Rotor: Rotor = buffered(pool.Rotor, (if need_Capture then 1 else 0) + (if need_LeftMotor then 1 else 0) + (if need_RightMotor then 1 else 0) + (if need_Engulfment then 1 else 0) + (if need_Division then 1 else 0));
gene supply_Frame: Frame = buffered(pool.Frame, (if need_Translation then 1 else 0) + (if need_Support then 1 else 0) + (if need_Replication then 0.333333 else 0));
gene supply_Carrier: Carrier = buffered(pool.Carrier, (if need_Minerals then 1 else 0));
gene supply_Tail: Tail = buffered(pool.Tail, (if need_LeftMotor then 1 else 0) + (if need_RightMotor then 1 else 0) + (if need_Touch then 0.333333 else 0) + (if need_Piercer then 1 else 0));
gene supply_Detector: Detector = buffered(pool.Detector, (if need_Vision then 1 else 0) + (if need_Touch then 1 else 0) + (if need_LeftHeat then 1 else 0) + (if need_RightHeat then 1 else 0));
gene supply_Pigment: Pigment = buffered(pool.Pigment, (if need_Vision then 0.333333 else 0));
gene supply_Replicase: Replicase = buffered(pool.Replicase, (if need_Replication then 1 else 0));
gene supply_Ring: Ring = buffered(pool.Ring, (if need_Division then 1 else 0));

assembly Gut: store(food) {
  Wall: 0.06;
  start_when: need_Gut;
  activity: 1;
}

assembly ExudateEnzyme: digest(exudate) {
  Catalyst: 0.025;
  start_when: need_ExudateEnzyme;
  activity: if gut.exudate.energy > 0 then 1 else 0;
}

assembly Capture: import(particle) {
  Mount: 0.01;
  Rotor: 0.02;
  start_when: need_Capture;
  activity: if gut.fraction < 0.7 then 1 else 0;
}

assembly TissueEnzyme: digest(tissue) {
  Catalyst: 0.08;
  start_when: need_TissueEnzyme;
  activity: if gut.tissue.energy > 0 then 1 else 0;
}

assembly WasteEnzyme: digest(waste) {
  Catalyst: 0.015;
  start_when: need_WasteEnzyme;
  activity: if gut.waste.energy > 0 then 1 else 0;
}

assembly Translation: translate() {
  Frame: 0.02;
  Catalyst: 0.02;
  start_when: need_Translation;
  activity: 1;
}

assembly Minerals: import(mineral) {
  Mount: 0.005;
  Carrier: 0.02;
  start_when: need_Minerals;
  activity: if nutrient.fraction < 0.9 then 1 else 0;
}

assembly EnergyStore: store(energy) {
  Wall: 0.08;
  start_when: need_EnergyStore;
  activity: 1;
}

assembly MineralStore: store(mineral) {
  Wall: 0.02;
  start_when: need_MineralStore;
  activity: 1;
}

assembly LeftMotor: propel() {
  Mount: 0.005;
  Rotor: 0.01;
  Tail: 0.01;
  start_when: need_LeftMotor;
  activity: clamp(move - steer * 0.5, 0, 1);
  at: 1.570796;
  direction: 0;
}

assembly RightMotor: propel() {
  Mount: 0.005;
  Rotor: 0.01;
  Tail: 0.01;
  start_when: need_RightMotor;
  activity: clamp(move + steer * 0.5, 0, 1);
  at: -1.570796;
  direction: 0;
}

assembly Vision: sense(optical) {
  Mount: 0.004;
  Detector: 0.012;
  Pigment: 0.004;
  start_when: need_Vision;
  activity: 1;
}

assembly Touch: sense(contact) {
  Mount: 0.002;
  Detector: 0.006;
  Tail: 0.002;
  start_when: need_Touch;
  activity: 1;
}

assembly Piercer: pierce() {
  Mount: 0.01;
  Tail: 0.03;
  Catalyst: 0.01;
  start_when: need_Piercer;
  activity: if !heat_escape && firm_contact && gut.fraction < 0.5 then 0.8 else 0;
}

assembly Engulfment: engulf() {
  Mount: 0.005;
  Rotor: 0.01;
  Wall: 0.01;
  start_when: need_Engulfment;
  activity: if gut.fraction < 0.5 then 1 else 0;
}

assembly Repair: repair() {
  Catalyst: 0.025;
  start_when: need_Repair;
  activity: 1;
}

assembly Support: support() {
  Frame: 0.06;
  start_when: need_Support;
  activity: 1;
}

assembly Envelope: grow() {
  Wall: 0.015;
  Catalyst: 0.005;
  start_when: need_Envelope;
  activity: if energy > 90 && body.area < body.birth_area * 2 then 0.8 else 0;
}

assembly Replication: replicate() {
  Frame: 0.005;
  Replicase: 0.015;
  start_when: need_Replication;
  activity: if energy > 80 then 1 else 0;
}

assembly Division: constrict() {
  Mount: 0.004;
  Rotor: 0.008;
  Ring: 0.008;
  start_when: need_Division;
  activity: if body.area + 0.000001 >= body.birth_area * 2 && energy > 100 then 1 else 0;
}

assembly LeftHeat: sense(heat) {
  Mount: 0.002;
  Detector: 0.008;
  start_when: need_LeftHeat;
  activity: 1;
  at: 1.5707963267948966;
}

assembly RightHeat: sense(heat) {
  Mount: 0.002;
  Detector: 0.008;
  start_when: need_RightHeat;
  activity: 1;
  at: -1.5707963267948966;
}
