assembly TailPiercer: pierce() {
  Mount: 55;
  Tail: 145;
  Catalyst: 50;
  start_when: need_TailPiercer;
  activity: if weapons_ready && sensed.TailTouch.valid && sensed.TailTouch.resistance > 0.1 && hunting_budget && meal < 170000 * body.area then 1 else 0;
  engage_when: may_strike;
  at: 3.141592653589793;
  direction: 3.141593;
}
