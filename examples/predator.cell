assembly TailInlet: import(particle) {
  Mount: 55;
  Rotor: 105;
  start_when: need_TailInlet;
  activity: if gut.fraction < 0.9 then 1 else 0;
  engage_when: !peer.resistance_valid || peer.resistance < 0.085;
  at: 3.141592653589793;
}

assembly TailMotor: propel() {
  Mount: 50;
  Rotor: 100;
  Tail: 100;
  start_when: need_TailMotor;
  activity: if built.LeftMotor < 0.02 && gut.fraction < 0.65 then 0.85 else 0;
  at: 3.141592653589793;
  direction: 3.141593;
}

