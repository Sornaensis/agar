# Shared products supply independently regulated physical recipes.
# Genes make stock; start_when permits new machines; activity runs built ones.
cellular counts;

product Catalyst = enzyme();
product Wall = membrane();
product Mount = anchor();
product Pigment = pigment();
product CoatPrecursor = scaffold();
product Glue = adhesin(CoatPrecursor);
product Detector = receptor();
product Carrier = transporter();
product Frame = scaffold();
product Replicase = replicase();
product Rotor = motor();
product Ring = constrictor();

# Tolerate modest wear while repair restores working capacity. The allowance
# stays below one machine, even when a larger body needs many copies.
fn missing(installed, required, unit) = installed + 0.000001 < required - min(required * 0.1, unit * 0.2);
fn enough(installed, required) = installed + 0.000001 >= required * 0.9;

let funded = (energy > 100000 || gut.energy > 0) && nutrient.stored > 10;
let expanding = body.area > body.birth_area * 1.6;
let powered = enough(built.Solar, 0.12) && enough(built.Respiration, 0.04);
let equipped = powered;
let surplus = equipped && energy > 550000;
# A recent drop in area records that this cell has already divided.
rb041 = true when populated(rf040) && body.area + 0.2 < rf040;
rf040 = body.area;
let left_peer = sensed.LeftBus.valid;
let right_peer = sensed.RightBus.valid;
let paired_contact = left_peer || right_peer;
signal rf021;
let partners = (if left_peer then 1 else 0) + (if right_peer then 1 else 0);
let center = partners >= 2;
rf021 = if center then 1 else 0;
let incoming = (sensed.LeftBus.signal_valid && sensed.LeftBus.value > 0.5)
  || (sensed.RightBus.signal_valid && sensed.RightBus.value > 0.5);
let rim = partners == 1 && incoming;

let need_Respiration = funded && (true) && missing(built.Respiration, (if expanding then 0.08 else 0.04), 0.04);
let need_Solar = funded && (true) && missing(built.Solar, (if expanding then 0.24 else 0.12), 0.12);
let need_LeftGlue = funded && (powered) && missing(built.LeftGlue, if expanding && (paired_contact || rb041) then 0.04 else 0.02, 0.02);
let need_LeftBus = funded && (powered) && missing(built.LeftBus, if expanding && (paired_contact || rb041) then 0.04 else 0.02, 0.02);
let need_RightGlue = funded && (powered) && missing(built.RightGlue, if expanding && (paired_contact || rb041) then 0.04 else 0.02, 0.02);
let need_RightBus = funded && (powered) && missing(built.RightBus, if expanding && (paired_contact || rb041) then 0.04 else 0.02, 0.02);
let need_RimSolar = funded && (rim) && missing(built.RimSolar, 0.06, 0.06);
let need_RimOutlet = funded && (rim && enough(built.RimSolar, 0.06)) && missing(built.RimOutlet, 0.015, 0.015);
let need_Translation = funded && (powered) && missing(built.Translation, (if expanding then 0.08 else 0.04), 0.04);
let need_Minerals = funded && (powered) && missing(built.Minerals, (if expanding then 0.05 else 0.025), 0.025);
let need_EnergyStore = funded && (powered) && missing(built.EnergyStore, if expanding then 0.08 else 0.04, 0.02);
let need_MineralStore = funded && (powered && body.area > 1.2) && missing(built.MineralStore, if expanding then 0.06 else 0.02, 0.02);
let need_Repair = funded && (integrity < 0.995) && missing(built.Repair, (if expanding then 0.05 else 0.025), 0.025);
let need_Support = funded && (powered && energy > 450000) && missing(built.Support, max(0.12, body.birth_area * 0.12), 0.06);
let need_Envelope = funded && (enough(built.Support, 0.12)) && missing(built.Envelope, (if expanding then 0.04 else 0.02), 0.02);
let need_Replication = funded && (enough(built.Support, 0.12)) && missing(built.Replication, (if expanding then 0.04 else 0.02), 0.02);
let need_Division = funded && (expanding) && missing(built.Division, (if expanding then 0.04 else 0.02), 0.02);

gene supply_CoatPrecursor: CoatPrecursor = if (need_LeftGlue || need_RightGlue) && pool.Glue < 10 && pool.CoatPrecursor < 10 then 1 else 0;
gene supply_Catalyst: Catalyst = if pool.Catalyst < 10 then (if need_Respiration then 1 else 0) + (if need_Solar then 0.25 else 0) + (if need_RimSolar then 0.25 else 0) + (if need_Translation then 1 else 0) + (if need_Repair then 1 else 0) + (if need_Envelope then 0.333333 else 0) else 0;
gene supply_Wall: Wall = if pool.Wall < 10 then (if need_Respiration then 0.6 else 0) + (if need_LeftGlue then 1 else 0) + (if need_LeftBus then 1 else 0) + (if need_RightGlue then 1 else 0) + (if need_RightBus then 1 else 0) + (if need_EnergyStore then 1 else 0) + (if need_MineralStore then 1 else 0) + (if need_Envelope then 1 else 0) else 0;
gene supply_Mount: Mount = if pool.Mount < 10 then (if need_Solar then 0.25 else 0) + (if need_LeftGlue then 1 else 0) + (if need_RightGlue then 1 else 0) + (if need_RimSolar then 0.25 else 0) + (if need_RimOutlet then 0.25 else 0) + (if need_Minerals then 0.25 else 0) + (if need_Division then 0.5 else 0) else 0;
gene supply_Pigment: Pigment = if pool.Pigment < 10 then (if need_Solar then 1 else 0) + (if need_RimSolar then 1 else 0) else 0;
gene supply_Glue: Glue = if pool.Glue < 10 then (if need_LeftGlue then 0.5 else 0) + (if need_RightGlue then 0.5 else 0) else 0;
gene supply_Detector: Detector = if pool.Detector < 10 then (if need_LeftBus then 0.666667 else 0) + (if need_RightBus then 0.666667 else 0) else 0;
gene supply_Carrier: Carrier = if pool.Carrier < 10 then (if need_RimOutlet then 1 else 0) + (if need_Minerals then 1 else 0) else 0;
gene supply_Frame: Frame = if pool.Frame < 10 then (if need_Translation then 1 else 0) + (if need_Support then 1 else 0) + (if need_Replication then 0.333333 else 0) else 0;
gene supply_Replicase: Replicase = if pool.Replicase < 10 then (if need_Replication then 1 else 0) else 0;
gene supply_Rotor: Rotor = if pool.Rotor < 10 then (if need_Division then 1 else 0) else 0;
gene supply_Ring: Ring = if pool.Ring < 10 then (if need_Division then 1 else 0) else 0;

assembly Respiration: respire(oxygen) {
  Catalyst: 250;
  Wall: 150;
  start_when: need_Respiration;
  activity: if oxygen > 0 && energy.fraction < 0.98 && (carbon.organic > 2000 * body.area || energy < 200000) then 1 else 0;
}

assembly Solar: harvest(light) {
  Mount: 200;
  Pigment: 800;
  Catalyst: 200;
  start_when: need_Solar;
  activity: 1;
  at: 1.5707963267948966;
}

assembly LeftGlue: adhere() {
  Mount: 80;
  Wall: 80;
  Glue: 40;
  start_when: need_LeftGlue;
  activity: 1;
  engage_when: peer.division_interface;
  at: 1.540796;
}

assembly LeftBus: junction(signal) {
  Wall: 120;
  Detector: 80;
  start_when: need_LeftBus;
  activity: 1;
  at: 1.540796;
}

assembly RightGlue: adhere() {
  Mount: 80;
  Wall: 80;
  Glue: 40;
  start_when: need_RightGlue;
  activity: 1;
  engage_when: peer.division_interface;
  at: 1.600796;
}

assembly RightBus: junction(signal) {
  Wall: 120;
  Detector: 80;
  start_when: need_RightBus;
  activity: 1;
  at: 1.600796;
}

assembly RimSolar: harvest(light) {
  Mount: 100;
  Pigment: 400;
  Catalyst: 100;
  start_when: need_RimSolar;
  activity: if rim then 1 else 0;
  at: 1.5707963267948966;
}

assembly RimOutlet: export(carbon) {
  Mount: 30;
  Carrier: 120;
  start_when: need_RimOutlet;
  activity: if rim && carbon.organic > 6500 * body.area && energy.fraction > 0.55 then 1 else 0;
  at: -1.570796;
}

assembly Translation: translate() {
  Frame: 200;
  Catalyst: 200;
  start_when: need_Translation;
  activity: 1;
}

assembly Minerals: import(mineral) {
  Mount: 50;
  Carrier: 200;
  start_when: need_Minerals;
  activity: if nutrient.fraction < 0.9 && energy.fraction > 0.05 then 1 else 0;
  at: 1.5707963267948966;
}

assembly EnergyStore: store(energy) {
  Wall: 200;
  start_when: need_EnergyStore;
  activity: 1;
}

assembly MineralStore: store(mineral) {
  Wall: 200;
  start_when: need_MineralStore;
  activity: 1;
}

assembly Repair: repair() {
  Catalyst: 250;
  start_when: need_Repair;
  activity: 1;
}

assembly Support: support() {
  Frame: 600;
  start_when: need_Support;
  activity: 1;
}

assembly Envelope: grow() {
  Wall: 150;
  Catalyst: 50;
  start_when: need_Envelope;
  activity: if energy > 900000 && body.area < body.birth_area * 2 then 0.8 else 0;
  at: 1.5707963267948966;
}

assembly Replication: replicate() {
  Frame: 50;
  Replicase: 150;
  start_when: need_Replication;
  activity: if energy > 800000 then 1 else 0;
}

assembly Division: constrict() {
  Mount: 40;
  Rotor: 80;
  Ring: 80;
  start_when: need_Division;
  activity: if body.area + 0.000001 >= body.birth_area * 2 && energy > 1000000 then 1 else 0;
  at: 0;
}
