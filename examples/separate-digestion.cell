# A feeding pathway is three independently assembled operations.
# This small demonstration needs organic particles in its environment.
cellular counts;

product Wall = membrane();
product Mount = anchor();
product Rotor = motor();
product Catalyst = enzyme();

gene walls: Wall = if built.FoodStore + 0.000001 < 0.04 && pool.Wall < 20 then 1 else 0;
gene mounts: Mount = if built.Intake + 0.000001 < 0.02 && pool.Mount < 20 then 0.5 else 0;
gene rotors: Rotor = if built.Intake + 0.000001 < 0.02 && pool.Rotor < 20 then 1 else 0;
# Two recipes compete fairly for the same catalyst stock.
gene enzymes: Catalyst = if (built.ExudateEnzyme + 0.000001 < 0.02 || built.TissueEnzyme + 0.000001 < 0.02) && pool.Catalyst < 20 then 1 else 0;

assembly FoodStore: store(food) {
  Wall: 400;
}
assembly Intake: import(particle) {
  Mount: 50;
  Rotor: 150;
  activity: if gut.fraction < 0.7 then 1 else 0;
}
assembly ExudateEnzyme: digest(soluble) {
  Catalyst: 200;
  activity: if gut.soluble.energy > 0 then 1 else 0;
}
assembly TissueEnzyme: digest(structural) {
  Catalyst: 200;
  activity: if gut.structural.energy > 0 then 1 else 0;
}
