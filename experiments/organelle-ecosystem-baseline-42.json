    {
      "id": "builtin:genome:phototroph",
      "name": "Phototroph",
      "source": "# Harvesting light and measuring light are separate capabilities.\nlet hot = heat.available && heat.valid && heat.value > 0.8;\nlet cool = if heat.bearing > 0 then heat.bearing - 3.141593\n           else heat.bearing + 3.141593;\nlet needs_minerals = nutrient.fraction < 0.2;\nturn = if hot then clamp(cool, -1, 1)\n       else if needs_minerals && chemical.valid then clamp(chemical.mineral_bearing, -1, 1)\n       else if light.available && light.valid then clamp(light.bearing, -1, 1) else 0;\nthrust = if hot then 0.3 else if needs_minerals then 0.08\n         else if light.valid && light.level < 0.3 then 0.07 else 0;\nfeed = 0;\nphotosynthesize = 1;\nabsorb = if nutrient.fraction < 0.85 then 1 else 0;\nrepair = if integrity < 0.92 && energy.fraction > 0.55 then 0.4 else 0;\ngrow = if body.maturity < 1 && energy.fraction > 0.6\n          && nutrient.stored > 0.06 then 0.65 else 0;\ndivide = body.division_ready && energy.fraction > 0.62;\n\n# Targets do not grant capabilities: each organ must be built and paid for.\nlet assemble = if energy.fraction > 0.45 && nutrient.stored > 0.01 then 1 else 0;\ntarget.core.count = 2;\ntarget.core.size = max(0.04, body.area * 0.04);\nbuild.core = assemble;\ntarget.photosynthetic.count = 2;\ntarget.photosynthetic.size = 0.17;\nbuild.photosynthetic = assemble;\ntarget.metabolic.count = 2;\ntarget.metabolic.size = 0.04;\nbuild.metabolic = assemble;\ntarget.reserve.count = 2;\ntarget.reserve.size = 0.06;\nbuild.reserve = assemble;\ntarget.transporter.count = 2;\ntarget.transporter.size = 0.03;\nbuild.transporter = assemble;\ntarget.flagellum.count = 2;\ntarget.flagellum.size = 0.025;\nbuild.flagellum = assemble;\ntarget.photoreceptor.count = 2;\ntarget.photoreceptor.size = 0.01;\nbuild.photoreceptor = assemble;\ntarget.thermoreceptor.count = 2;\ntarget.thermoreceptor.size = 0.01;\nbuild.thermoreceptor = assemble;\ntarget.chemoreceptor.count = 2;\ntarget.chemoreceptor.size = 0.015;\nbuild.chemoreceptor = assemble;\ntarget.cortex.count = 2;\ntarget.cortex.size = 0.02;\nbuild.cortex = assemble;",
      "description": "Build photosynthetic units and transporters, using paid light and chemical sensors.",
      "languageVersion": 3,
      "createdAt": 0,
      "updatedAt": 0,
      "genomeId": "builtin:genome:phototroph",
      "starterBody": "producer",
      "count": 72
