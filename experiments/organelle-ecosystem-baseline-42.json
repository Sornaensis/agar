    {
      "id": "builtin:genome:forager",
      "name": "Forager",
      "source": "# Objects have appearance and geometry, not an edible or enemy flag.\nlet visible = object.available && object.valid;\nlet bearing = if visible then angle(object.offset)\n              else if chemical.valid then chemical.organic_bearing else 0;\nlet touching = contact.valid || (visible && length(object.offset) < 7 * sqrt(body.area) + 4);\nlet seeking = gut.fraction < 0.55;\nturn = if seeking && (visible || chemical.valid) then clamp(bearing * 1.8, -1, 1)\n       else sin(age * 0.65 + id) * 0.35;\nthrust = if touching || gut.fraction > 0.45 then 0\n         else if seeking && visible then 0.35 else 0.06;\nfeed = 1;\nengulf = gut.fraction < 0.65;\nphotosynthesize = 0;\nabsorb = if nutrient.fraction < 0.85 then 1 else 0;\nrepair = if integrity < 0.92 && energy.fraction > 0.55 then 0.4 else 0;\ngrow = if body.maturity < 1 && energy.fraction > 0.6\n          && nutrient.stored > 0.06 then 0.65 else 0;\ndivide = body.division_ready && energy.fraction > 0.62;\n\n# Targets do not grant capabilities: each organ must be built and paid for.\nlet assemble = if energy.fraction > 0.45 && nutrient.stored > 0.01 then 1 else 0;\ntarget.core.count = 2;\ntarget.core.size = max(0.04, body.area * 0.04);\nbuild.core = assemble;\ntarget.digestive.count = 2;\ntarget.digestive.size = 0.13;\nbuild.digestive = assemble;\ntarget.metabolic.count = 2;\ntarget.metabolic.size = 0.04;\nbuild.metabolic = assemble;\ntarget.reserve.count = 2;\ntarget.reserve.size = 0.06;\nbuild.reserve = assemble;\ntarget.transporter.count = 2;\ntarget.transporter.size = 0.02;\nbuild.transporter = assemble;\ntarget.phagocyte.count = 2;\ntarget.phagocyte.size = 0.05;\nbuild.phagocyte = assemble;\ntarget.flagellum.count = 2;\ntarget.flagellum.size = 0.05;\nbuild.flagellum = assemble;\ntarget.optical.count = 2;\ntarget.optical.size = 0.025;\nbuild.optical = assemble;\ntarget.chemoreceptor.count = 2;\ntarget.chemoreceptor.size = 0.015;\nbuild.chemoreceptor = assemble;\ntarget.mechanoreceptor.count = 2;\ntarget.mechanoreceptor.size = 0.01;\nbuild.mechanoreceptor = assemble;\ntarget.cortex.count = 2;\ntarget.cortex.size = 0.02;\nbuild.cortex = assemble;",
      "description": "Scavenge contacting material, following visible objects and local organic cues.",
      "languageVersion": 3,
      "createdAt": 0,
