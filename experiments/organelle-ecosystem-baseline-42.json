    {
      "id": "builtin:genome:predator",
      "name": "Predator",
      "source": "# Neither vision nor contact reveals another cell’s genome, diet or energy.\nlet hungry = energy.fraction < 0.7 && gut.fraction < 0.45;\nlet visible = object.available && object.valid;\nlet approachable = visible && object.area < body.area * 1.2;\nlet hot = heat.valid && heat.value > 0.82;\nlet cool = if heat.bearing > 0 then heat.bearing - 3.141593 else heat.bearing + 3.141593;\nlet touching = contact.available && contact.valid;\nturn = if hot then clamp(cool, -1, 1)\n       else if hungry && approachable then clamp(angle(object.offset) * 1.8, -1, 1)\n       else sin(age * 0.5 + id) * 0.4;\nthrust = if hot then 0.35 else if touching || gut.fraction > 0.45 then 0\n         else if hungry && approachable then 0.5 else 0.07;\nfeed = 1;\nphotosynthesize = 0;\nbite = if hungry && touching then 0.8 else 0;\nengulf = hungry && touching;\ndefend = if touching then 0.2 else 0;\nabsorb = if nutrient.fraction < 0.85 then 1 else 0;\nrepair = if integrity < 0.92 && energy.fraction > 0.55 then 0.4 else 0;\ngrow = if body.maturity < 1 && energy.fraction > 0.6\n          && nutrient.stored > 0.06 then 0.65 else 0;\ndivide = body.division_ready && energy.fraction > 0.62;\n\n# Targets do not grant capabilities: each organ must be built and paid for.\nlet assemble = if energy.fraction > 0.55 && nutrient.stored > 0.01 then 1 else 0;\ntarget.core.count = 2;\ntarget.core.size = max(0.04, body.area * 0.04);\nbuild.core = assemble;\ntarget.digestive.count = 2;\ntarget.digestive.size = 0.13;\nbuild.digestive = assemble;\ntarget.metabolic.count = 2;\ntarget.metabolic.size = 0.04;\nbuild.metabolic = assemble;\ntarget.reserve.count = 2;\ntarget.reserve.size = 0.06;\nbuild.reserve = assemble;\ntarget.transporter.count = 2;\ntarget.transporter.size = 0.02;\nbuild.transporter = assemble;\ntarget.phagocyte.count = 2;\ntarget.phagocyte.size = 0.04;\nbuild.phagocyte = assemble;\ntarget.flagellum.count = 2;\ntarget.flagellum.size = 0.065;\nbuild.flagellum = assemble;\ntarget.piercer.count = 2;\ntarget.piercer.size = 0.07;\nbuild.piercer = assemble;\ntarget.optical.count = 2;\ntarget.optical.size = 0.035;\nbuild.optical = assemble;\ntarget.mechanoreceptor.count = 2;\ntarget.mechanoreceptor.size = 0.015;\nbuild.mechanoreceptor = assemble;\ntarget.thermoreceptor.count = 2;\ntarget.thermoreceptor.size = 0.01;\nbuild.thermoreceptor = assemble;\ntarget.cortex.count = 2;\ntarget.cortex.size = 0.035;\nbuild.cortex = assemble;",
